# Database (PostgreSQL / Supabase)
# For Supabase: Transaction pooler URL for DATABASE_URL (port 6543), Direct session URL for DIRECT_URL (port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/krillion_india?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/krillion_india?schema=public"

# Redis (BullMQ queue)
REDIS_URL="redis://localhost:6379"

# AI Provider (Groq)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Scoring Parameters
PRIOR_STRENGTH="1000"

# Telegram Admin Notification
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Admin API Security
ADMIN_SECRET_KEY="dev_admin_secret_change_in_production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
